# ==========================================================================
# Configuración de despliegue a Hostinger (rsync vía SSH)
# --------------------------------------------------------------------------
# 1. Copiá este archivo a "deploy.env":   cp deploy.env.example deploy.env
# 2. Completá los valores reales en "deploy.env".
# 3. deploy.env está en .gitignore: NO se commitea. Nunca pongas secretos aquí.
# ==========================================================================

# Host SSH. En Hostinger suele ser la IP del servidor o un nombre tipo
# "153.xx.xx.xx". Lo encontrás en hPanel → Avanzado → Acceso SSH.
SSH_HOST="123.456.789.0"

# Usuario SSH. En Hostinger tiene forma "u123456789" (NO tu email).
SSH_USER="u123456789"

# Puerto SSH. En el hosting compartido de Hostinger es 65002 (no el 22).
SSH_PORT="65002"

# Ruta ABSOLUTA de la raíz web en el servidor (donde vive el index.html público).
# Típico en Hostinger:
#   /home/u123456789/domains/tudominio.com/public_html
#   o bien  /home/u123456789/public_html
REMOTE_PATH="/home/u123456789/domains/tudominio.com/public_html"

# (Opcional) Ruta a tu clave SSH privada para no escribir la contraseña cada vez.
# Dejar vacío ("") para usar autenticación por contraseña.
# Recomendado: generar una clave y cargarla en hPanel → Acceso SSH → Claves SSH.
SSH_KEY=""

# (Opcional) URL pública del sitio. Solo se muestra al final como recordatorio.
SITE_URL="https://tudominio.com"
